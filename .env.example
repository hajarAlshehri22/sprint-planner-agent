# Copy to .env and fill in.  .env is git-ignored: never commit keys.

# ---- Which AI provider? ------------------------------------------------------------------
# openrouter : free models, ~50 requests/day without credit           https://openrouter.ai/keys
# gemini     : Google AI Studio free key, NO card, ~1,500 requests/day https://aistudio.google.com/apikey
# groq       : free key, no card, 1,000 requests/day (small daily token limit)  https://console.groq.com/keys
# ollama     : a model on your own computer, unlimited                https://ollama.com
AGENT_PROVIDER=openrouter

# The key for the provider you chose (only that one is needed)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Model ids differ per provider. List yours with:  uv run plan.py models
# OpenRouter example (free models with tool calling):
AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AGENT_FALLBACKS=nvidia/nemotron-3.5-super-vl:free,thinkingmachines/inkling:free
# Gemini example (pick a "flash" model from `uv run plan.py models`):
# AGENT_PROVIDER=gemini
# AGENT_MODEL=gemini-3.8-flash
# AGENT_FALLBACKS=gemini-3.5-flash,gemini-flash-latest

# Seconds between model calls (stays under requests-per-minute limits).
# Defaults: gemini 6.5, groq 2.1, openrouter 0.
# MIN_SECONDS_BETWEEN_CALLS=6.5

# How much the model thinks before each step (Gemini default: low = much faster). Empty = provider default.
# AGENT_REASONING_EFFORT=low

# Harness budgets per run
MAX_STEPS=30
MAX_COST=0.10

# Optional: a real GitLab project (otherwise a local mock is used). Use a TEST project.
GITLAB_URL=
GITLAB_TOKEN=
GITLAB_PROJECT=

# Offline scripted model (tests / demo without a key):  PLANNER_FAKE_LLM=1
PLANNER_FAKE_LLM=0
# Replay identical model requests from disk (free re-runs). Set 0 for fresh samples.
PLANNER_CACHE=1
